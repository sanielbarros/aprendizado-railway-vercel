# Postgres local (Docker) — desenvolvimento apenas.
# Copie este arquivo para ".env" e ajuste se quiser. Nunca commitar o .env real.
POSTGRES_USER=feedbackhub
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=feedbackhub_dev
# 5433 (nao 5432) porque ha um Postgres nativo do Windows ocupando a porta padrao nesta maquina.
POSTGRES_PORT=5433
