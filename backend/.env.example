# Copie para ".env" nesta mesma pasta (backend/). Nunca commitar o .env real.
APP_NAME=FeedbackHub API
ENVIRONMENT=development

# Para desenvolvimento local (Postgres em Docker):
# DATABASE_URL=postgresql+psycopg://feedbackhub:changeme_local_only@localhost:5433/feedbackhub_dev

# Para produção (Supabase):
# Pegar em Supabase console → Settings → Database → Connection string
# Formato: postgresql+psycopg://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@db.XXXXX.supabase.co:5432/postgres
